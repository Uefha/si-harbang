APP_NAME="SI-HARBANG"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=si_harbang
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

QUEUE_CONNECTION=database
CACHE_STORE=database

FILESYSTEM_DISK=public

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@tarunanusantara.sch.id"
MAIL_FROM_NAME="${APP_NAME}"

# ==== Konfigurasi khusus SI-HARBANG ====
# Batas SLA (hari) default, nilai aktual diatur per-prioritas di tabel `prioritas`
HARBANG_SLA_DARURAT=1
HARBANG_SLA_TINGGI=3
HARBANG_SLA_SEDANG=7
HARBANG_SLA_RENDAH=14

# Prefix nomor laporan otomatis: HRB-YYYYMMDD-0001
HARBANG_NOMOR_PREFIX=HRB
